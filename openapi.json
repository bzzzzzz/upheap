                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`tag_name_taken`, `version_conflict` or `heap_archived`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "428": {
            "description": "`version_required`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ClosedItems": {
        "type": "object",
        "required": [
          "heap",
          "items"
        ],
        "properties": {
          "heap": {
            "$ref": "#/components/schemas/HeapSummary"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "description": "Most recently closed first."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` for the next page; `null` on the last page."
          }
        }
      },
      "Contributor": {
        "type": "object",
        "description": "One labelled reason for an item's position.",
        "required": [
          "factor",
          "label",
          "share_percent"
        ],
        "properties": {
          "factor": {
            "$ref": "#/components/schemas/Factor"
          },
          "label": {
            "type": "string"
          },
          "share_percent": {
            "type": "integer",
            "format": "int32",
            "description": "Share of the item's priority, 1 to 100.",
            "minimum": 0
          }
        }
      },
      "CreateItemRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DueInput"
              }
            ]
          },
          "effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size"
              }
            ]
          },
          "impact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size"
              }
            ]
          },
          "tag_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Tags of the same heap, at most 50."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateTagRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "description": "1 to 50 characters, unique in the heap ignoring case."
          }
        }
      },
      "Due": {
        "type": "object",
        "description": "A due time, ready to show.",
        "required": [
          "at",
          "date",
          "firm",
          "label",
          "overdue"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64",
            "description": "UTC milliseconds."
          },
          "date": {
            "type": "string",
            "description": "The calendar date in the request's timezone, `YYYY-MM-DD`, for date inputs."
          },
          "firm": {
            "type": "boolean",
            "description": "Exact deadline (`true`) or loose due time (`false`)."
          },
          "label": {
            "type": "string",
            "description": "\"in a few weeks\" for loose due times; \"tomorrow\" or \"12 Mar\" for deadlines, in the request's timezone."
          },
          "overdue": {
            "type": "boolean",
            "description": "Only deadlines become overdue."
          }
        }
      },
      "DueInput": {
        "type": "object",
        "description": "A due time as entered: a calendar date, stored as the end of that day in the request's timezone.",
        "required": [
          "date",
          "firm"
        ],
        "properties": {
          "date": {
            "type": "string",
            "description": "`YYYY-MM-DD`.",
            "example": "2027-03-12"
          },
          "firm": {
            "type": "boolean"
          }
        }
      },
      "Factor": {
        "type": "string",
        "enum": [
          "age",
          "deadline",
          "value"
        ]
      },
      "HeapSummary": {
        "type": "object",
        "required": [
          "id",
          "team_id",
          "name",
          "archived"
        ],
        "properties": {
          "archived": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "team_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "id",
          "heap_id",
          "title",
          "state",
          "tags",
          "created_at",
          "version",
          "allowed_actions"
        ],
        "properties": {
          "allowed_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemAction"
            }
          },
          "closed_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "UTC milliseconds; set exactly when the item is closed."
          },
          "closed_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it was closed, ready to show (\"yesterday\", \"3 Nov\")."
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "UTC milliseconds."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Due"
              }
            ]
          },
          "effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size",
                "description": "`null` when unset."
              }
            ]
          },
          "heap_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "impact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size",
                "description": "`null` when unset."
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/ItemState"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemTag"
            },
            "description": "By name."
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Send back in `If-Match` when editing.",
            "minimum": 0
          }
        }
      },
      "ItemAction": {
        "type": "string",
        "description": "An action the caller can take on an item. Clients show controls only for these.",
        "enum": [
          "edit",
          "change_state",
          "reopen"
        ]
      },
      "ItemPatchRequest": {
        "type": "object",
        "description": "A partial edit. Leave a field out to keep it; send `null` to clear it.",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DueInput"
              }
            ]
          },
          "effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size"
              }
            ]
          },
          "impact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Size"
              }
            ]
          },
          "state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ItemState"
              }
            ]
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Replaces the item's tags. Tags of the same heap, at most 50. Send `[]` to clear them; `null` is refused."
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ItemState": {
        "type": "string",
        "description": "Item state. `done` and `wont_do` are closed.",
        "enum": [
          "open",
          "in_progress",
          "blocked",
          "done",
          "wont_do"
        ]
      },
      "ItemTag": {
        "type": "object",
        "description": "A tag on an item: enough to show it.",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "user",
          "teams"
        ],
        "properties": {
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamSummary"
            }
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An error response body (RFC 9457 problem details).",
        "required": [
          "code",
          "title",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, for example `version_conflict`."
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "description": "The input field the error is about, when there is one."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present on unexpected errors, so the operator can find the details in the log."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary. May change; don't match on it."
          }
        }
      },
      "RankedItem": {
        "type": "object",
        "required": [
          "position",
          "contributors",
          "item"
        ],
        "properties": {
          "contributors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contributor"
            },
            "description": "The biggest reasons for the position, largest first."
          },
          "item": {
            "$ref": "#/components/schemas/Item"
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "description": "1-based position within its group.",
            "minimum": 0
          }
        }
      },
      "RankedList": {
        "type": "object",
        "required": [
          "heap",
          "as_of",
          "pinned",
          "ranked",
          "blocked"
        ],
        "properties": {
          "as_of": {
            "type": "integer",
            "format": "int64",
            "description": "The time the ranking used (UTC milliseconds). Send it back as `as_of` to keep the order stable."
          },
          "blocked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedItem"
            },
            "description": "Blocked items, highest priority first. Hidden by default."
          },
          "heap": {
            "$ref": "#/components/schemas/HeapSummary"
          },
          "pinned": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedItem"
            },
            "description": "In-progress items, pinned above the rest."
          },
          "ranked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedItem"
            },
            "description": "Open items, highest priority first."
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "member"
        ]
      },
      "SignInRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Size": {
        "type": "string",
        "description": "Effort or impact.",
        "enum": [
          "s",
          "m",
          "l",
          "xl"
        ]
      },
      "Tag": {
        "type": "object",
        "required": [
          "id",
          "heap_id",
          "name",
          "version",
          "allowed_actions"
        ],
        "properties": {
          "allowed_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagAction"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "heap_id": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "description": "Send back in `If-Match` when editing.",
            "minimum": 0
          }
        }
      },
      "TagAction": {
        "type": "string",
        "description": "An action the caller can take on a tag.",
        "enum": [
          "edit"
        ]
      },
      "TagList": {
        "type": "object",
        "required": [
          "heap",
          "tags",
          "allowed_actions"
        ],
        "properties": {
          "allowed_actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagListAction"
            }
          },
          "heap": {
            "$ref": "#/components/schemas/HeapSummary"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            },
            "description": "By name."
          }
        }
      },
      "TagListAction": {
        "type": "string",
        "description": "An action the caller can take on a heap's tag list.",
        "enum": [
          "create"
        ]
      },
      "TagPatchRequest": {
        "type": "object",
        "description": "A partial edit. Leave a field out to keep it; send `null` to clear the description.",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TeamSummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "heaps"
        ],
        "properties": {
          "heaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HeapSummary"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The caller's role in this team."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
