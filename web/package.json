{
  "name": "upheap-web",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#api-fetch": {
      "local-build": "./src/local/fetch.ts",
      "default": "./src/api/networkFetch.ts"
    },
    "#local-database": {
      "local-build": "./src/local/database.ts",
      "default": "./src/api/noLocalDatabase.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:local": "playwright test -c playwright.local.config.ts",
    "dev:local": "vite --mode local-build",
    "build:local": "tsc -b && vite build --mode local-build",
    "build:backend": "cd ../crates/local && wasm-pack build --target web --release --no-pack --out-dir ../../web/src/local/backend",
    "typecheck:local": "tsc -p tsconfig.local.json",
    "smoke:local": "node scripts/local-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.70.0",
    "motion": "^14.9.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
